#!/bin/sh
# The CI container mounts the source at /picolibc owned by another user
if [ -d /picolibc ] && ! git config --global --get-all safe.directory | grep -qxF /picolibc; then
    git config --global --add safe.directory /picolibc
fi
git ls-files | xargs clang-format -i
git diff > clang-format.patch
if [ -s clang-format.patch ]; then
    echo "Formatting errors found. Patch to fix them:"
    cat clang-format.patch
    exit 1
fi
