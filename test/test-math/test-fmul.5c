load "test-float.5c"

typedef struct {
	real x, y;
} pair_t;

pair_t[] test_values = {
	{
		.x = 0x1.e1e1e78787878p-1,
		.y = 0x1.1p0,
	},
};

real
fmul(real x, real y)
{
	return imprecise(x * y, 24);
}

void
compute_sign(real xi, real yi)
{
	compute_real_real( xi,  yi, fmul);
	compute_real_real( xi, -yi, fmul);
	compute_real_real(-xi,  yi, fmul);
	compute_real_real(-xi, -yi, fmul);
}

void
main()
{
	for (int i = 0; i < dim(test_values); i++) {
		real xi = imprecise(test_values[i].x, prec);
		real yi = imprecise(test_values[i].y, prec);
		compute_sign(xi, yi);
	}
}

main();
