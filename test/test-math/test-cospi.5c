load "test-float.5c"

real[] test_values = {
	0, 1, 2, 3, 5, 6, 7,
	0.5, 1.5, 2.5, 3.5, 5.5, 6.5, 7.5,
	0.25, 0.25 - 0x1p-23,
	0x1p+23, 0x1.000002p+23, 0x1p+24, 0x1.000002p+24,
	0x1p+52, 0x1.0000000000001p+52, 0x1p+53, 0x1.0000000000001p+53,
	0x1p+63, 0x1.0000000000000002p+63, 0x1p+64, 0x1.0000000000000002p+64,
	0x1p+112, 0x1.0000000000000000000000000001p+112, 0x1p+113, 0x1.0000000000000000000000000001p+113,
};

real pi_4096 = pi_value(4096);

real
cospi(real x)
{
	real x2 = 2 * x;
	if (x2 == floor(x2) && x2 % 2 == 1)
		return 0;
	return cos(imprecise(x, 4096) * pi_4096);
}

void
main()
{
	for (int i = 0; i < dim(test_values); i++) {
		real ri = imprecise(test_values[i], prec);
		compute_real_one(ri, cospi);
		compute_real_one(-ri, cospi);
	}
	for (real r = 1e-38; r < 1e38; r *= 2.1) {
		real ri = imprecise(r, prec);
		compute_real_one(ri, cospi);
		compute_real_one(-ri, cospi);
	}
}

main();
