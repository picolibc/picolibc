load "test-float.5c"

real
rootn(real x, int y)
{
	if (y == 0)
		raise nan();
	if (x < 0 && (y & 1) == 0)
		raise nan();

	real abs_x = abs(x);
	real ret = pow(abs_x, 1/y);
	if (x < 0)
		ret = -ret;
	return ret;
}

typedef struct {
	real 	x;
	int	y;
} pair_t;

pair_t[] test_values = {
	{ .x = 10, .y = 0 },
	{ .x = 2, .y = 600, },
	{ .x = 2, .y = 5000 },
	{ .x = 2, .y = 80000 },
};

void
main()
{
	for (int i = 0; i < dim(test_values); i++)
		compute_real_int(test_values[i].x, test_values[i].y, rootn);
	for (real x = 1e-38; x <= 1e38; x *= 1111) {
		real xi = imprecise(x, prec);
		for (int y = -10; y < 10; y++) {
			compute_real_int(-xi, y, rootn);
			compute_real_int(xi, y, rootn);
		}
	}
}

main();
