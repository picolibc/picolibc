string[] values = {
	"-NAN",
	"-sNAN",
	"-INFINITY",
	"-0x1p10",
	"-1.0",
	"-0x1p-10",
	"-0.0",
	"0.0",
	"0x1p-10",
	"1.0",
	"0x1p10",
	"INFINITY",
	"sNAN",
	"NAN",
};

struct {
	string	fn;
	string	p;
}[] convs = {
	{ .fn = "FN32", .p = "P32" },
	{ .fn = "FN64", .p = "P64" },
	{ .fn = "FN80", .p = "P80" },
	{ .fn = "FN80M", .p = "P80" },
	{ .fn = "FN128", .p = "P128" },
};

void
print_value(string v)
{
	printf("REAL(");
	for (int i = 0; i < dim(convs); i++) {
		if (i > 0)
			printf(", ");
		switch (v) {
		case "sNAN":
			printf("%s(__builtin_nans)(\"\")", convs[i].fn);
			break;
		case "-sNAN":
			printf("-%s(__builtin_nans)(\"\")", convs[i].fn);
			break;
		case "NAN":
		case "INFINITY":
			printf("%s(%s)", convs[i].p, v);
			break;
		case "-NAN":
		case "-INFINITY":
			printf("%s(%s)", convs[i].p, v);
			break;
		default:
			printf("%s(%s)", convs[i].fn, v);
			break;
		}
	}
	printf("), ");
}

void
main()
{
	for (int i = 0; i < dim(values); i++) {
		for (int j = 0; j < dim(values); j++) {
			printf("{ .x1 = ");
			print_value(values[i]);
			printf(" .x2 = ");
			print_value(values[j]);
			printf(" .y = %d },\n", i <= j ? 1 : 0);
		}
	}
}

main();
