int prec = 2048;

int arg_prec;

exception nan();
exception infinity(bool neg);
exception bad_precision(int prec);

typedef union {
	real	r;
	bool	i;
	void	n;
} result_t;

complex
imprecise_arg(complex x, int prec)
{
	arg_prec = prec;
	return imprecise(x, prec);
}

const real max_binary32 = imprecise(0x1.fffffep+127);
const real min_binary32 = imprecise(0x1p-126);
const real min_denorm_binary32 = imprecise(0x1p-149);

real
copysign(real x, real y)
{
	x = abs(x);
	if (y >= 0)
		return x;
	return -x;
}

real
real32(real x)
{
	int	precision = 24;
	int	exp_x = exponent(imprecise(x));
	if (exp_x < exponent(min_denorm_binary32)) {
		precision = 1;
		if (abs(x) > min_denorm_binary32 / 2)
			x = copysign(min_denorm_binary32, x);
		else
			x = 0;
	} else if (exp_x < exponent(min_binary32)) {
		precision = exp_x - exponent(min_denorm_binary32) + 1;
	}
	return imprecise_arg(x, precision);
}

result_t
real32_result(result_t r)
{
	union switch (r) {
	case r x:
		if (abs(x) > max_binary32)
			r = (result_t) { .i = (x < 0) };
		else
			r = (result_t) { .r = real32(x) };
		break;
	default:
		break;
	}
	return r;
}

int
toint_gen(result_t r, int prec, int exp_bits)
{
	int sign, exp, sig;

	int exp_bias = (1 << (exp_bits - 1)) - 1;

	union switch (r) {
	case i i:
		sign = i ? 1 : 0;
		exp = (1 << exp_bits) - 1;
		sig = 0;
		break;
	case n:
		sign = 0;
		exp = (1 << exp_bits) - 1;
		sig = (1 << (prec - 2));
		break;
	case r x:
		real xc = abs(x);
		real mant = mantissa(xc) * 2;
		exp = exponent(xc) - 1;

		sign = x < 0 ? 1 : 0;
		if (xc == 0) {
			exp = 0;
			sig = 0;
		} else {
			exp += exp_bias;
			if (exp <= 0) {
				sig = mant * 2**(exp + prec - 2);
				exp = 0;
			} else {
				sig = mant * 2**(prec - 1) - (1 << (prec-1));
			}
		}
		break;
	}
	return (sign << (prec + exp_bits - 1)) | (exp << (prec-1)) | sig;
}

result_t
toreal_gen(int x, int prec, int exp_bits)
{
	int sign, exp, sig;
	int exp_bias = (1 << (exp_bits - 1)) - 1;

	sign = (x >> (prec + exp_bits - 1));
	exp = (x >> (prec - 1)) & ((1 << exp_bits) - 1);
	sig = x & ((1 << (prec - 1)) - 1);

	if (exp == ((1 << exp_bits) - 1)) {
		if (sig != 0) {
			return (result_t) { .n = ◊ };
		}
		return (result_t) { .i = (sign != 0) };
	}

	if (exp == 0) {
		exp = 2 - prec - exp_bias;
		if (sig == 0)
			prec = 1;
		else
			prec = 1 + floor(log2(sig));
	} else {
		sig |= (1 << (prec-1));
		exp = exp - exp_bias - (prec - 1);
	}
	real y = sig * 2 ** exp;
	if (sign != 0)
		y = -y;

	return (result_t) { .r = imprecise(y, prec) };
}

const real max_binary64 = imprecise(0x1.fffffffffffffp+1023);
const real min_binary64 = imprecise(0x1p-1022);
const real min_denorm_binary64 = imprecise(0x1p-1074);

real
real64(real x)
{
	int	precision = 53;
	int	exp_x = exponent(imprecise(x));
	if (exp_x < exponent(min_denorm_binary64)) {
		precision = 1;
		if (abs(x) > min_denorm_binary64 / 2)
			x = copysign(min_denorm_binary64, x);
		else
			x = 0;
	} else if (exp_x < exponent(min_binary64)) {
		precision = exp_x - exponent(min_denorm_binary64) + 1;
	}
	return imprecise_arg(x, precision);
}

result_t
real64_result(result_t r)
{
	union switch (r) {
	case r x:
		if (abs(x) > max_binary64)
			r = (result_t) { .i = x < 0 };
		else
			r = (result_t) { .r = real64(x) };
		break;
	default:
		break;
	}
	return r;
}

