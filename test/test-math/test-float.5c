const real max_binary128 = imprecise(0x1.ffffffffffffffffffffffffffffp16383);
const real min_binary128 = imprecise(0x1p-16382);
const real min_denorm_binary128 = imprecise(0x1p-16494);

real
real128(real x)
{
	int	precision = 113;
	int	exp_x = exponent(imprecise(x));
	if (exp_x < exponent(min_denorm_binary128)) {
		precision = 1;
		if (abs(x) > min_denorm_binary128 / 2)
			x = copysign(min_denorm_binary128, x);
		else
			x = 0;
	} else if (exp_x < exponent(min_binary128)) {
		precision = exp_x - exponent(min_denorm_binary128) + 1;
	}
	return imprecise_arg(x, precision);
}

result_t
real128_result(result_t r)
{
	union switch (r) {
	case r x:
		if (abs(x) > max_binary128)
			r = (result_t) { .i = x < 0 };
		else
			r = (result_t) { .r = real128(x) };
		break;
	default:
		break;
	}
	return r;
}

int
toint32(result_t r)
{
	return toint_gen(real32_result(r), 24, 8);
}

result_t
toreal32(int x)
{
	return toreal_gen(x, 24, 8);
}

int
toint64(result_t r)
{
	return toint_gen(real64_result(r), 53, 11);
}

result_t
toreal64(int x)
{
	return toreal_gen(x, 53, 11);
}

int
toint80_gen(result_t r, bool moto)
{
	int sign, exp, sig;
	int prec = 64;
	int exp_bits = 15;
	int exp_bias = (1 << (exp_bits - 1)) - 1;

	union switch (r) {
	case i i:
		sign = i ? 1 : 0;
		exp = (1 << exp_bits) - 1;
		if (moto)
			sig = 0;
		else
			sig = (1 << (prec -1));
		break;
	case n:
		sign = 0;
		exp = (1 << exp_bits) - 1;
		sig = (1 << (prec - 2));
		break;
	case r x:
		real xc = abs(x);
		real mant = mantissa(xc) * 2;
		exp = exponent(xc) - 1;
		sign = x < 0 ? 1 : 0;
		if (xc == 0) {
			exp = 0;
			sig = 0;
		} else {
			exp += exp_bias;
			if (moto) {
				if (exp < 0) {
					sig = mant * 2**(exp + prec - 1);
					exp = 0;
				} else {
					sig = mant * 2**(prec-1);
				}
			} else {
				if (exp <= 0) {
					sig = mant * 2**(exp + prec - 2);
					exp = 0;
				} else {
					sig = mant * 2**(prec-1);
				}
			}
		}
		break;
	}

	return (sign << (prec + exp_bits)) | (exp << (prec)) | sig;
}

result_t
toreal80_gen(int x, bool moto)
{
	int prec = 64;
	int exp_bits = 15;
	int exp_bias = (1 << (exp_bits - 1)) - 1;

	int sign = x >> (prec + exp_bits);
	int exp = (x >> (prec)) & ((1 << exp_bits) - 1);
	int sig = x & ((1 << prec) - 1);

	if (exp == ((1 << exp_bits) - 1)) {
		if (!moto)
			sig &= ((1 << (prec -1)) - 1);
		if (sig != 0)
			return (result_t) { .n = ◊ };
		return (result_t) { .i = (sign != 0) };
	}

	if (exp == 0) {
		if (moto)
			exp = 1 - prec - exp_bias;
		else
			exp = 2 - prec - exp_bias;
		if (sig == 0)
			prec = 1;
		else
			prec = 1 + floor(log2(sig));
	} else {
		exp = exp - exp_bias - (prec - 1);
	}
	real y = sig * 2 ** exp;
	if (sign != 0)
		y = -y;

	return (result_t) { .r = imprecise(y, prec) };
}

int
toint80(result_t r)
{
	return toint80_gen(real80_result(r), false);
}

result_t
toreal80(int x)
{
	return toreal80_gen(x, false);
}

int
toint80m(result_t r)
{
	return toint80_gen(real80m_result(r), true);
}

result_t
toreal80m(int x)
{
	return toreal80_gen(x, true);
}

int
toint128(result_t r)
{
	return toint_gen(real128_result(r), 113, 15);
}

result_t
toreal128(int x)
{
	return toreal_gen(x, 113, 15);
}

typedef struct {
	real(real) conv;
	int(result_t)  toint;
	result_t(int)  toreal;
	int        precision;
	int	   exp;
	string     macro;
	real       min_denorm;
	real       min;
	real       max;
} conv_t;

conv_t[] real_convs = {
	{
		.conv = real32,
		.toint = toint32,
		.toreal = toreal32,
		.precision = 24,
		.exp = 8,
		.macro = "FN32",
		.min_denorm = min_denorm_binary32,
		.min = min_binary32,
		.max = max_binary32
	},
	{
		.conv = real64,
		.toint = toint64,
		.toreal = toreal64,
		.precision = 53,
		.exp = 11,
		.macro = "FN64",
		.min_denorm = min_denorm_binary64,
		.min = min_binary64,
		.max = max_binary64
	},
	{
		.conv = real80,
		.toint = toint80,
		.toreal = toreal80,
		.precision = 64,
		.exp = 15,
		.macro = "FN80",
		.min_denorm = min_denorm_binary80,
		.min = min_binary80,
		.max = max_binary80
	},
	{
		.conv = real80m,
		.toint = toint80m,
		.toreal = toreal80m,
		.precision = 64,
		.exp = 15,
		.macro = "FN80M",
		.min_denorm = min_denorm_binary80m,
		.min = min_binary80m,
		.max = max_binary80m
	},
	{
		.conv = real128,
		.toint = toint128,
		.toreal = toreal128,
		.precision = 113,
		.exp = 15,
		.macro = "FN128",
		.min_denorm = min_denorm_binary128,
		.min = min_binary128,
		.max = max_binary128
	},
};

const int nformat = dim(real_convs);

void
print_one_real(real x, int i)
{
	if (abs(x) > real_convs[i].max)
		printf("%sINFINITY", x>0 ? "" : "-");
	else if (abs(x) < real_convs[i].min_denorm)
		printf("%s0", x>0 ? "" : "-");
	else
		printf("%s(%a)", real_convs[i].macro, x);
}

void
print_one_result(result_t y, int i)
{
	union switch (y) {
	case r r:
		print_one_real(r, i);
		break;
	case i i:
		printf("%sINFINITY", i?"-":"");
		break;
	case n:
		printf("NAN");
		break;
	}
}

void
print_real(real[nformat] x, result_t[nformat] y)
{
	printf("{ .x = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_real(x[i], i);
	}
	printf("), .y = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_result(y[i], i);
	}
	printf(") },\n");
}

void
print_real(real[nformat] x, result_t[nformat] y)
{
	printf("{ .x = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_real(x[i], i);
	}
	printf("), .y = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_result(y[i], i);
	}
	printf(") },\n");
}

void
print_int_real(int x1, real[nformat] x2, result_t[nformat] y)
{
	printf("{ .x1 = %d,", x1);
	printf(" .x2 = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_real(x2[i], i);
	}
	printf("), .y = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_result(y[i], i);
	}
	printf(") },\n");
}

int current_conversion;

void
compute_real_one(real x, real(real) f)
{
	real[nformat]	xp;
	result_t[nformat] yp;
	for (int i = 0; i < nformat; i++) {
		current_conversion = i;
		xp[i] = real_convs[i].conv(x);
		try {
			try {
				yp[i].r = real_convs[i].conv(f(imprecise(xp[i], prec)));
			} catch divide_by_zero(real x, real y) {
				if (x == 0)
					raise nan();
				raise infinity(x < 0);
			} catch invalid_argument(string error, int i, poly v) {
				raise nan();
			}
		} catch infinity(bool sign) {
			yp[i].i = sign;
		} catch nan() {
			yp[i].n = ◊;
		}
	}
	print_real(xp, yp);
}

bool
is_inf(real x)
{
	return real_convs[current_conversion].max < abs(x);
}

bool
is_denorm(real x)
{
	return real_convs[current_conversion].min_denorm <= abs(x) && abs(x) < real_convs[current_conversion].min;
}

bool
is_zero(real x)
{
	return abs(x) < real_convs[current_conversion].min_denorm;
}

void
compute_int_real(int x1, real x2, real(int, real) f)
{
	real[nformat]	x1p, x2p;
	result_t[nformat] yp;
	for (int i = 0; i < nformat; i++) {
		current_conversion = i;
		x2p[i] = real_convs[i].conv(x2);
		try {
			try {
				yp[i].r = real_convs[i].conv(f(x1, imprecise(x2p[i], prec)));
			} catch divide_by_zero(real x, real y) {
				if (x == 0)
					raise nan();
				raise infinity(x < 0);
			} catch invalid_argument(string error, int i, poly v) {
				raise nan();
			}
		} catch infinity(bool sign) {
			yp[i].i = sign;
		} catch nan() {
			yp[i].n = ◊;
		}
	}
	print_int_real(x1, x2p, yp);
}

void
print_real_int(real[nformat] x1, int x2, result_t[nformat] y)
{
	printf("{ .x1 = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_real(x1[i], i);
	}
	printf("), .x2 = %d, .y = REAL(", x2);
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_result(y[i], i);
	}
	printf(") },\n");
}

void
compute_real_int(real x1, int x2, real(real, int) f)
{
	real[nformat]	x1p, x2p;
	result_t[nformat] yp;
	for (int i = 0; i < nformat; i++) {
		current_conversion = i;
		x1p[i] = real_convs[i].conv(x1);
		try {
			try {
				yp[i].r = real_convs[i].conv(f(imprecise(x1p[i], prec), x2));
			} catch divide_by_zero(real x, real y) {
				if (x == 0)
					raise nan();
				raise infinity(x < 0);
			} catch invalid_argument(string error, int i, poly v) {
				raise nan();
			}
		} catch infinity(bool sign) {
			yp[i].i = sign;
		} catch nan() {
			yp[i].n = ◊;
		}
	}
	print_real_int(x1p, x2, yp);
}

void
print_real_real(real[nformat] x1, real[nformat] x2, result_t[nformat] y)
{
	printf("{ .x1 = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_real(x1[i], i);
	}
	printf("), .x2 = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
