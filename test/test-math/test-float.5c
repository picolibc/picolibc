		if (i > 0)
			printf(", ");
		print_one_real(x2[i], i);
	}
	printf("), .x3 = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_real(x3[i], i);
	}
	printf("), .y = REAL(");
	for (int i = 0; i < nformat; i++) {
		if (i > 0)
			printf(", ");
		print_one_result(y[i], i);
