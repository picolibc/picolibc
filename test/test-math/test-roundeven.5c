load "test-float.5c"

real[] test_values = {
	pi,
	0.1,
	0.25,
	0.625,
	1,
	2,
};

real
round(real x)
{
	if (x > 0)
		return floor(x + 0.5);
	else
		return ceil(x-0.5);
}

real
roundeven(real x)
{
	real y = round(x);
	if (abs(x - y) == 0.5 && (y & 1) != 0) {
		if (y > 0)
			y -= 1;
		else
			y += 1;
	}
	return y;
}

void
main()
{
	for (int i = 0; i < dim(test_values); i++) {
		compute_real_one(test_values[i], roundeven);
		compute_real_one(-test_values[i], roundeven);
	}
	for (int b = 0; b <= 149; b++) {
		for (real frac = 0.25; frac < 1; frac *= 2) {
			real value = (1 << b) - frac;
			compute_real_one(value, roundeven);
			compute_real_one(-value, roundeven);
		}
	}
}

main();
