load "test-float.5c"

typedef struct {
	real x;
	int y;
} pair_t;

pair_t[] test_values = {
	{ .x = 0x1.254bc333c9c37p+73, .y = -11, },
	{ .x = 0x1.000002p+0, .y = 0x1fffffff },
	{ .x = 0x1.001p0, .y = 10000000000 },
};

bool
is_odd(real y)
{
	return y % 2 == 1;
}

bool
is_even(real y)
{
	return y % 2 == 0;
}

bool
is_int(real y)
{
	return floor(y) == y;
}

real
wrap_pown(real x, int y)
{
	if (x == 0 && y < 0 && is_odd(y))
		raise infinity(false);

	if (x == 0 && y < 0 && !is_odd(y))
		raise infinity(false);

	if (x == 0 && is_odd(y) && y > 0)
		return 0;

	if (x == 0 && y > 0 && !is_odd(y))
		return 0;

	/* inf y */
	if (is_inf(y)) {
		if (x == -1)
			return 1;

		if (abs(x) < 1 && y < 0)
			raise infinity(false);
		if (abs(x) > 1 && y < 0)
			return 0;
		if (abs(x) < 1 && y > 0)
			return 0;
		if (abs(x) > 1 && y > 0)
			raise infinity(false);
	}
	/* inf x */
	if (is_inf(x)) {
		if (x < 0 && is_odd(y) && y < 0)
			return 0;
		if (x < 0 && y < 0 && !is_odd(y))
			return 0;
		if (x < 0 && is_odd(y) && y > 0)
			raise infinity(true);
		if (x < 0 && y > 0 && !is_odd(y))
			raise infinity(false);
		if (x > 0 && y < 0)
			return 0;
		if (x > 0 && y > 0)
			raise infinity(false);
	}

	if (x == 1)
		return 1;
	if (y == 0)
		return 1;

	if (!is_inf(x) && x < 0 && !is_inf(y) && !is_int(y))
		raise nan();

	if (is_int(y) && x < 0) {
		real r = pow(-x, y);
		if (is_odd(y))
			r = -r;
		return r;
	}
	return pow(x, y);
}

void
compute_sign(real xi, int yi)
{
	compute_real_int( xi,  yi, wrap_pown);
	compute_real_int( xi, -yi, wrap_pown);
	compute_real_int(-xi,  yi, wrap_pown);
	compute_real_int(-xi, -yi, wrap_pown);
}

void
main()
{

	for (int i = 0; i < dim(test_values); i++) {
		real xi = imprecise(test_values[i].x, prec);
		int yi = test_values[i].y;
		compute_sign(xi, yi);
	}
	for (real x = 1e-100; x <= 1e100; x *= 1111) {
		for (int y = -20; y <= 20; y++) {
			real xi = imprecise(x, prec);
			compute_sign(xi, y);
		}
	}
}

main();
