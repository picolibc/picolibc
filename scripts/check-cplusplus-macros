# Check that picolibc headers work in C++
#
# usage: check-cplusplus-macros <list> <source> <compiler> [args...]
#
# Compiles <source> as C++ with -fsyntax-only, then includes each
# header named in <list> and checks that none of the macros listed
# there is defined in C++. C++ code may use any name which C++ doesn't
# define as a macro, so these C-only macros would break it. Defining
# _GNU_SOURCE makes the headers define everything they can, so a
# missing C++ check shows up with any C++ version.

set -o pipefail
export LC_ALL=C

list="$1"
source="$2"
shift 2

"$@" -x c++ -fsyntax-only "$source" || exit 1

entries=$(grep -v -E '^[[:space:]]*(#|$)' "$list")
if [ -z "$entries" ]; then
    echo "no macros listed in $list"
    exit 1
fi

headers=$(echo "$entries" | awk '{ print $1 }' | sort -u)
hidden=$(echo "$entries" | awk '{ print $2 }' | sort -u)

macros=$(for header in $headers; do
             echo "#include <$header>"
         done | "$@" -x c++ -D_GNU_SOURCE -E -dM - |
             awk '$1 == "#define" { sub(/\(.*/, "", $2); print $2 }' | sort -u) || exit 1

if ! grep -q -x __PICOLIBC__ <<< "$macros"; then
    echo "the headers listed in $list are not from picolibc"
    exit 1
fi

defined=$(comm -12 <(echo "$hidden") <(echo "$macros"))

if [ -n "$defined" ]; then
    echo "defined as macros in C++ (see $list):" $defined
    exit 1
fi
