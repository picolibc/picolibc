# Run a 32-bit Arm Linux program. Use the host when it can run AArch32
# binaries itself (or through binfmt-misc), otherwise use qemu-arm.
#
# PICOLIBC_ARM_LINUX_QEMU=yes forces qemu-arm, =no forces the host.
#
# The probe runs the armhf dynamic loader (libc6:armhf), which the
# glibc-linked -native tests need anyway.

loader=/lib/ld-linux-armhf.so.3

case "${PICOLIBC_ARM_LINUX_QEMU:-auto}" in
    no)
	exec "$@"
	;;
    yes)
	;;
    *)
	if "$loader" --version > /dev/null 2>&1; then
	    exec "$@"
	fi
	;;
esac

if ! command -v qemu-arm > /dev/null 2>&1; then
    echo "$0: host cannot run 32-bit Arm binaries and qemu-arm is missing" 1>&2
    exit 1
fi
exec qemu-arm "$@"
